# ==========================================
# Database & Cache (PostgreSQL + Redis)
# ==========================================
# Database connection string for asyncpg
DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/rankerpilot"
# Redis connection string for Celery/Caching
REDIS_URL="redis://localhost:6379/0"

# ==========================================
# Object Storage (S3 / MinIO)
# ==========================================
# S3 compatible endpoint URL
S3_ENDPOINT="http://localhost:9000"
# S3 bucket name
S3_BUCKET="rankerpilot-assets"
# S3 access key
S3_ACCESS_KEY="minioadmin"
# S3 secret key
S3_SECRET_KEY="minioadmin"

# ==========================================
# Authentication & Security
# ==========================================
# JWT secret for signing access tokens
JWT_SECRET="changeme_jwt_secret"
# JWT secret for signing refresh tokens
JWT_REFRESH_SECRET="changeme_jwt_refresh_secret"
# Encryption key for sensitive tokens in DB
TOKEN_ENCRYPTION_KEY="changeme_encryption_key"

# ==========================================
# OAuth (Google)
# ==========================================
# Google OAuth Client ID for login
GOOGLE_OAUTH_CLIENT_ID="your_google_client_id"
# Google OAuth Client Secret for login
GOOGLE_OAUTH_CLIENT_SECRET="your_google_client_secret"

# ==========================================
# LLM APIs
# ==========================================
# Anthropic API Key for Claude agents
ANTHROPIC_API_KEY="sk-ant-..."
# OpenAI compatible base URL for other models
OPENAI_COMPAT_BASE_URL="https://api.openai.com/v1"

# ==========================================
# Integrations (DataForSEO, Google, Moz)
# ==========================================
# DataForSEO login email
DATAFORSEO_LOGIN="login@example.com"
# DataForSEO API password
DATAFORSEO_PASSWORD="your_dfs_password"
# Budget limit for DFS audits in USD
DFS_AUDIT_BUDGET_USD="100.0"
# Google PageSpeed Insights API Key
PSI_API_KEY="your_psi_api_key"
# Moz Access ID
MOZ_ACCESS_ID="your_moz_access_id"
# Moz Secret Key
MOZ_SECRET_KEY="your_moz_secret_key"

# ==========================================
# Observability
# ==========================================
# Sentry DSN for backend error tracking
SENTRY_DSN="https://..."
# Current environment (development, staging, production)
ENV="development"

# ==========================================
# Frontend (Next.js)
# ==========================================
# Public URL for the API backend
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000"
# Sentry DSN for frontend error tracking
NEXT_PUBLIC_SENTRY_DSN="https://..."
